{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "outputDirectory": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*\\.js)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable", "Content-Type": "application/javascript" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}


